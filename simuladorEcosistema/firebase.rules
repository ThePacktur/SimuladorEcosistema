rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
    match /simulaciones/{simulationId} {
      allow create: if request.auth != null && request.resource.data.usuarioId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.usuarioId == request.auth.uid ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['docente', 'admin']
      );
      allow update, delete: if request.auth != null && resource.data.usuarioId == request.auth.uid;
    }
  }
}